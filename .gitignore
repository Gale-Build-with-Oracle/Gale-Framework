# Secrets — never commit
.env*
codex/config.toml
maw/maw.config.json

# Oracle runtime artifacts (memory, mailbox, worktree state)
ψ/
.maw/
.oracle-build-backups/

# Claude Code session transcripts — NEVER publish. your-framework (private) tracks
# ~825MB of these under claude-sessions/; they are raw tool output and routinely
# contain DB names, connection details and anything else printed during a session.
# `*.jsonl` above does not cover them (they are .txt / .meta.json), so a tree-copy
# sync from your-framework would silently publish them into this PUBLIC repo.
claude-sessions/

# Databases / logs / dumps
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
*.jsonl

# Dependencies / OS
node_modules/
.DS_Store
